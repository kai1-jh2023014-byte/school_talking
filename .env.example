# Cookie 署名用。本番では必ず長いランダム文字列に変えてください。
SESSION_SECRET=tsunagu-demo-secret-2026

# 任意。無いときは校内のルールベース分類だけが動きます。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TypeSafe Jev（任意）。教科・分野・緊急度の判断だけに使います。答えは出させません。
# 公式: https://docs.typesafe.ai/api
TYPESAFE_API_KEY=your_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai
# 未設定なら GET /v1/models でアカウントが使える名前を取得します。
TYPESAFE_DEFAULT_MODEL=
# ミリ秒。未設定は 4000。
TYPESAFE_TIMEOUT_MS=4000

# bcrypt の計算回数。デモは 10 で十分です。
BCRYPT_ROUNDS=10
